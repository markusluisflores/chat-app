FROM node:22-alpine AS builder
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN node_modules/.bin/esbuild worker/index.ts --bundle --platform=node --outfile=dist/worker.js

FROM node:22-alpine
WORKDIR /app
COPY --from=builder /app/dist/worker.js ./dist/worker.js
CMD ["node", "dist/worker.js"]
